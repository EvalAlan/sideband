# Matrix IDs will end in :MATRIX_SERVER_NAME. Changing this later is a migration,
# not a normal configuration edit. For local-only evaluation, localhost is fine.
MATRIX_SERVER_NAME=localhost
SYNAPSE_REPORT_STATS=no
SYNAPSE_BIND_ADDRESS=127.0.0.1
SYNAPSE_PORT=8008
TZ=UTC

# Known release tags verified against the official registries/projects on 2026-07-15.
# Review upstream release notes before changing them. mautrix :latest is a moving
# development build, not the latest stable release.
SYNAPSE_TAG=v1.156.0
MAUTRIX_TELEGRAM_TAG=v0.2606.0
MAUTRIX_DISCORD_TAG=v0.7.6
MAUTRIX_META_TAG=v0.2606.0
MAUTRIX_GOOGLECHAT_TAG=v0.5.2
